<script>
function simulatePriceChanges() {
    fetch('/stocks/simulate-changes', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Stock prices have been updated!');
            location.reload();
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error updating stock prices');
    });
}
</script>
